{
  "version": "0.1.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {},
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "colar-ts",
  "bin": {
    "colar-ts": "dist/colar-ts.cjs.production.min.js"
  },
  "author": "rafael.oliveira",
  "module": "dist/colar-ts.esm.js",
  "size-limit": [
    {
      "path": "dist/colar-ts.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/colar-ts.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.0",
    "husky": "^9.1.7",
    "size-limit": "^12.0.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
